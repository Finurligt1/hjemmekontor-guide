---
import { withBase } from "../lib/url";
import { priceLabel } from "../lib/price";

interface Props {
  slug: string;
  productName: string;
  image: string;
  imageAlt: string;
  excerpt: string;
  priceTier: "budget" | "mellem" | "premium";
}

const { slug, productName, image, imageAlt, excerpt, priceTier } =
  Astro.props as Props;
---

<a class="product-card" href={withBase(`/produkter/${slug}/`)}>
  <img src={withBase(image)} alt={imageAlt} loading="lazy" />
  <div class="product-card-body">
    <span class="price-tier">{priceLabel[priceTier]}</span>
    <h3 class="product-card-title">{productName}</h3>
    <p class="product-card-excerpt">{excerpt}</p>
  </div>
</a>
